# .env로 복사한 뒤 실제 값을 채워 넣을 것. .env는 .gitignore에 포함되어 커밋되지 않음.

# https://www.last.fm/api/account/create 에서 발급
LASTFM_API_KEY=

# https://www.discogs.com/settings/developers 에서 발급 (Generate new token)
DISCOGS_TOKEN=

# MusicBrainz User-Agent에 넣을 연락처 (이메일 또는 프로젝트 URL). 정책상 필수.
MB_CONTACT=

# https://developer.spotify.com/dashboard 에서 앱 생성 후 발급
# Redirect URI는 앱 설정에도 동일하게 등록해야 함 (기본값 사용 시 등록 필요)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
